{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oo.release-control-api/create-release/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id", "identity_revision", "idempotency_key", "config_commit",
    "candidate_id", "version", "base_version", "role", "scope", "expected_version"
  ],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "identity_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "config_commit": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "base_version": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}
      ]
    },
    "role": {"type": "string", "pattern": "^oo_r_[A-Za-z0-9_]{1,40}$"},
    "scope": {"enum": ["test_scope", "production"]},
    "expected_version": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}
      ]
    }
  }
}
