{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oo.release-control-api/rollback/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "identity_revision", "idempotency_key", "expected_version"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "identity_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "expected_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"}
  }
}
