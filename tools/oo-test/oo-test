#!/usr/bin/env python3
import sys
sys.dont_write_bytecode = True
if sys.argv[1:2] == ["gate"]:
    del sys.argv[1]
    from defects import main
elif sys.argv[1:2] == ["l3"]:
    del sys.argv[1]
    from l3 import main
elif sys.argv[1:2] == ["fast"]:
    del sys.argv[1]
    from fast import main
elif sys.argv[1:2] == ["coverage"]:
    del sys.argv[1]
    from coverage import main
elif sys.argv[1:2] == ["snapshot"]:
    del sys.argv[1]
    from snapshots import main
elif sys.argv[1:2] == ["timing"]:
    del sys.argv[1]
    from timing import main
elif sys.argv[1:2] == ["matrix"] and "--engine" in sys.argv and sys.argv[sys.argv.index("--engine") + 1:][:1] in (
    ["mongodb"], ["opensearch"], ["elasticsearch"]
):
    from document_matrix import main
elif sys.argv[1:2] == ["t6"]:
    del sys.argv[1]
    from t6 import main
elif sys.argv[1:2] == ["t2"]:
    del sys.argv[1]
    from t2 import main
elif sys.argv[1:2] == ["t3t4"]:
    del sys.argv[1]
    from t3t4 import main
else:
    from runner import main

if __name__ == "__main__":
    sys.exit(main())
