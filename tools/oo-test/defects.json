    "id": "decimal256-carry",
    "fix": "127479529",
    "detector": "rust",
    "mutations": [
      {
        "path": "crates/oo-connectors/src/mysql/values.rs",
        "before": "carry = wide >> 8;",
        "after": "carry >>= 8;",
        "count": 2
      }
    ],
    "command": [
      "cargo",
      "test",
      "--locked",
      "-p",
      "oo-connectors",
      "--lib",
      "--features",
      "mysql,oracle",
      "ta_wide_decimal_carries",
      "--",
      "--nocapture"
    ],
    "detector_patches": [
      {
        "path": "crates/oo-connectors/src/mysql/values.rs",
        "append": "\n#[cfg(test)]\nmod ta_defect_regression {\n    #[test]\n    fn ta_wide_decimal_carries() {\n        for precision in [40, 65, 76] {\n            for digits in [\"256\".to_owned(), \"65536\".to_owned(), \"9\".repeat(precision)] {\n                for negative in [false, true] {\n                    let value = oo_core::ExactDecimal::new(negative, &digits, 0).unwrap();\n                    let actual = super::unscaled_i256(&value).unwrap();\n                    let expected = format!(\"{}{digits}\", if negative { \"-\" } else { \"\" })\n                        .parse::<arrow_buffer::i256>().unwrap();\n                    assert_eq!(arrow_buffer::i256::from_le_bytes(actual), expected);\n                }\n            }\n        }\n    }\n}\n"
      }
    ],
    "baseline_patches": [
      {
        "path": "crates/oo-connectors/src/mysql/values.rs",
        "before": "carry >>= 8;",
        "after": "carry = wide >> 8;",
        "count": 2
      }
    ],
    "note": "Fix 127479529 is on v0.3/integrate only; v0.2 still carries the defect, so the gate overlays the fix for the baseline.",
    "layer": "L0"
  },
