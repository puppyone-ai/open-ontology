{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oo.secret-control/resolve-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["secret_ref", "project_id", "namespace"],
  "properties": {
    "secret_ref": {"type": "string", "pattern": "^secret://[a-z0-9][a-z0-9_-]{0,62}/[a-z][a-z0-9_]{0,62}/[a-z][a-z0-9_]{0,62}/[a-z][a-z0-9_]{0,62}$"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "version": {"type": "integer", "minimum": 1, "maximum": 1000000}
  }
}
