{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oo.secret-control/revoke-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity_revision", "idempotency_key"],
  "properties": {
    "identity_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"}
  }
}
