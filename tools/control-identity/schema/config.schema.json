{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oo.control-identity/config/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "https_origin", "listen_host", "listen_port", "tls_cert_file", "tls_key_file",
    "issuer", "audience", "client_id", "client_secret_file", "redirect_uris",
    "config_commit", "revision", "idp_ca_file", "pg", "bindings", "bootstrap",
    "idle_seconds", "absolute_seconds", "oauth_ttl_seconds", "bootstrap_ttl_seconds",
    "clock_skew_seconds"
  ],
  "properties": {
    "https_origin": {"type": "string", "pattern": "^https://[^/]+$"},
    "listen_host": {"type": "string", "minLength": 1},
    "listen_port": {"type": "integer", "minimum": 0, "maximum": 65535},
    "tls_cert_file": {"type": "string", "minLength": 1},
    "tls_key_file": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "pattern": "^https://[^/?#]+$"},
    "audience": {"type": "string", "minLength": 1, "maxLength": 128},
    "client_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "client_secret_file": {"type": "string", "minLength": 1},
    "redirect_uris": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^https://[^?#]+$"}
    },
    "config_commit": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000000},
    "idp_ca_file": {"type": "string", "minLength": 1},
    "pg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "database", "user", "password_file", "ca_file"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "database": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "user": {"const": "oo_identity_admin"},
        "password_file": {"type": "string", "minLength": 1},
        "ca_file": {"type": "string", "minLength": 1}
      }
    },
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "bootstrap": {"$ref": "#/$defs/binding"},
    "idle_seconds": {"type": "integer", "minimum": 5, "maximum": 86400},
    "absolute_seconds": {"type": "integer", "minimum": 5, "maximum": 86400},
    "oauth_ttl_seconds": {"type": "integer", "minimum": 5, "maximum": 600},
    "bootstrap_ttl_seconds": {"type": "integer", "minimum": 5, "maximum": 1800},
    "clock_skew_seconds": {"type": "integer", "minimum": 0, "maximum": 120},
    "binding_git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary", "root", "reference"],
      "properties": {
        "binary": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "reference": {"const": "refs/heads/management"}
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "project_id", "role"],
      "properties": {
        "subject": {"type": "string", "minLength": 1, "maxLength": 256},
        "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "role": {"enum": ["admin", "reviewer", "steward", "auditor", "business_owner"]}
      }
    }
  },
  "description": "config_commit is SHA-256 of canonical JSON with sorted object keys and no insignificant whitespace. The preimage object is protocol oo.control-identity/config-commit/v1, revision, issuer, audience, client_id, sorted redirect_uris, bindings sorted by project_id then subject then role as objects with keys project_id, role, subject, and bootstrap as customer_owner false, fixture_class explicit_test_fixture, project_id, role, subject. Secret file paths, PEM bytes, and binding_git are not in the preimage. binding_git is optional. When it is absent, binding preview and approve return binding.unavailable. absolute_seconds must be greater than or equal to idle_seconds. The bootstrap subject, project, and role must also appear in bindings. One subject has one role per project."
}
