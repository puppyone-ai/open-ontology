{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oo.feedback.receiver.source/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "producer",
    "outcome_schema",
    "receipt_id",
    "project",
    "evidence_sha256",
    "catalog_sha256",
    "relationships_sha256",
    "profile_sha256",
    "feedback_sha256",
    "schema_hash",
    "channel",
    "untrusted"
  ],
  "properties": {
    "producer": {"const": "oo.selfbuild-suggestions/v1"},
    "outcome_schema": {"const": "oo.selfbuild-suggestions.outcome/v1"},
    "receipt_id": {"type": "string"},
    "project": {"type": "string"},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relationships_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feedback_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "schema_hash": {"type": "string"},
    "channel": {"type": "string"},
    "untrusted": {"type": "boolean"},
    "kind": {"type": "string"},
    "target": {"type": "string"},
    "feedback_text": {"type": "string"}
  }
}
