{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oo.source-control-api/import-action/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "identity_revision", "idempotency_key"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "identity_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"}
  }
}
