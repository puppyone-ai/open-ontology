    "at": {
      "type": "string",
      "format": "date-time"
    },
    "drive_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object"
    },
    "actor": {
      "type": "object",
      "description": "Who caused an event (1.13). `kind` is `cli`, `app`, `mcp` (the client named by the `OO-Docs-Client` header of the control token), `agent` (an Agent token, or the control token with an `OO-Docs-Agent` header; `name` is the token name or the header), `cloud` (a cloud proxy token) or `local` (no or an unknown client header). Events appended by a background worker carry the actor of the request that caused them (same file or Drive, within 10 minutes) and none when no request is known.",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "cli",
            "app",
            "mcp",
            "agent",
            "cloud",
            "local"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "examples": [
        {
          "kind": "app"
        },
        {
          "kind": "agent",
          "name": "claude"
        }
      ]
    }
  },
