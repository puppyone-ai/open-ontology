{
  "components": {
    "schemas": {
      "AcceptedOperation": {
        "additionalProperties": false,
        "properties": {
          "operation_id": {
            "$ref": "#/components/schemas/OperationId"
          },
          "status": {
            "$ref": "#/components/schemas/OperationStatus"
          }
        },
        "required": [
          "operation_id",
          "status"
        ],
        "type": "object"
      },
      "BoundedText2000": {
        "maxLength": 2000,
        "pattern": "^[^\\u{0}]*$",
        "type": "string"
      },
      "ByteBoundedText65536": {
        "description": "maxLength is a Unicode scalar ceiling. The UTF-8 byte budget is the same number and is enforced by Rust.",
        "maxLength": 65536,
        "pattern": "^[^\\u{0}]*$",
        "type": "string"
      },
      "ClientContext": {
        "additionalProperties": false,
        "properties": {
          "purpose": {
            "$ref": "#/components/schemas/ClientPurpose"
          },
          "turn": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "purpose",
          "turn"
        ],
        "type": "object"
      },
      "ClientPurpose": {
        "enum": [
          "answer",
          "export",
          "resolve",
          "search"
        ],
        "type": "string"
      },
      "ConsistencyMode": {
        "enum": [
          "transactional",
          "per_table"
        ],
        "type": "string"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "description": "`retryable` is fixed by [`ErrorCode::retryable`]. It is not an independent\nfield a caller can flip after a valid parse. Deserialization rejects a\nbody that disagrees. Serialization writes the code's value and refuses a\nstored flag that does not match. HTTP `Retry-After` is not a field of this\nobject; a later HTTP implementation may set that header and is not invented\nhere.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "hint": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/BoundedText2000"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "$ref": "#/components/schemas/BoundedText2000"
          },
          "query_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QueryId"
              },
              {
                "type": "null"
              }
            ]
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "type": "object"
      },
      "ErrorCode": {
        "enum": [
          "UNAUTHENTICATED",
          "SQL_PARSE_ERROR",
          "STATEMENT_NOT_ALLOWED",
          "FUNCTION_NOT_ALLOWED",
          "RELATION_NOT_FOUND",
          "COLUMN_NOT_ALLOWED",
          "UNQUALIFIED_RELATION",
          "COST_TOO_HIGH",
          "TIMEOUT",
          "TABLE_PAUSED",
          "QUERY_TOO_SHORT",
          "ENUMERATION_REFUSED",
          "RATE_LIMITED",
          "OVERLOADED",
          "INTERNAL",
          "AUDIT_UNAVAILABLE",
          "IDEMPOTENCY_CONFLICT",
          "CONFLICT",
          "VERSION_UNSUPPORTED",
          "SCHEMA_INVALID"
        ],
        "type": "string"
      },
      "ErrorEnvelope": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "ExactDecimal": {
        "description": "Exact decimal string. JSON numbers are rejected for this type.",
        "pattern": "^[+-]?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
        "type": "string"
      },
      "ExportCompletion": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "$ref": "#/components/schemas/ExactDecimal"
          },
          "freshness": {
            "items": {
              "$ref": "#/components/schemas/Freshness"
            },
            "type": "array"
          },
          "result_sha256": {
            "$ref": "#/components/schemas/HexDigest"
          },
          "rows": {
            "$ref": "#/components/schemas/ExactDecimal"
          },
          "status": {
            "$ref": "#/components/schemas/ExportStatus"
          },
          "truncated": {
            "type": "boolean"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array"
          }
        },
        "required": [
          "status",
          "rows",
          "bytes",
          "truncated",
          "result_sha256",
          "freshness",
          "warnings"
        ],
        "type": "object"
      },
      "ExportStatus": {
        "enum": [
          "completed",
          "failed"
        ],
        "type": "string"
      },
      "Freshness": {
        "additionalProperties": false,
        "properties": {
          "as_of": {
            "$ref": "#/components/schemas/Rfc3339Timestamp"
          },
          "lag_ms": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/FreshnessState"
          },
          "table": {
            "$ref": "#/components/schemas/QualifiedTable"
          }
        },
        "required": [
          "table",
          "as_of",
          "lag_ms",
          "state"
        ],
        "type": "object"
      },
      "FreshnessState": {
        "enum": [
          "live",
          "stale",
          "paused"
        ],
        "type": "string"
      },
      "HexDigest": {
        "maxLength": 71,
        "minLength": 64,
        "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
        "type": "string"
      },
      "Label": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^[^\\u{0}-\\u{8}\\u{B}\\u{C}\\u{E}-\\u{1F}\\u{7F}]+$",
        "type": "string"
      },
      "OperationId": {
        "maxLength": 67,
        "minLength": 11,
        "pattern": "^op_[0-9A-Za-z]{8,64}$",
        "type": "string"
      },
      "OperationStatus": {
        "enum": [
          "accepted",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "type": "string"
      },
      "PageRequest": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Label"
              },
              {
                "type": "null"
              }
            ]
          },
          "limit": {
            "format": "int32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "limit"
        ],
        "type": "object"
      },
      "Position": {
        "description": "Source position: non-negative scale-0 decimal of at most 38 digits. JSON numbers are rejected.",
        "maxLength": 39,
        "minLength": 1,
        "pattern": "^[+]?[0-9]{1,38}$",
        "type": "string"
      },
      "QualifiedTable": {
        "maxLength": 192,
        "minLength": 3,
        "pattern": "^[a-z][a-z0-9_]{0,62}\\.[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "type": "string"
      },
      "QueryCell": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "boolean"
          },
          {
            "maxLength": 500,
            "type": "string"
          }
        ]
      },
      "QueryColumn": {
        "additionalProperties": false,
        "description": "Column metadata. Parameters are private so a struct literal cannot bypass\n[`Self::new`]. Serialization runs the same check and returns an error\ninstead of emitting a type the JSON door rejects.",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/TableName"
          },
          "precision": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "scale": {
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "timezone": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TimezoneName"
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "$ref": "#/components/schemas/Label"
          }
        },
        "required": [
          "name",
          "type"
        ],
        "type": "object"
      },
      "QueryFormat": {
        "enum": [
          "json",
          "markdown"
        ],
        "type": "string"
      },
      "QueryId": {
        "maxLength": 42,
        "minLength": 8,
        "pattern": "^q_[0-9A-Za-z]{6,40}$",
        "type": "string"
      },
      "QueryRequest": {
        "additionalProperties": false,
        "properties": {
          "client_context": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ClientContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "format": {
            "$ref": "#/components/schemas/QueryFormat"
          },
          "max_rows": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "sql": {
            "$ref": "#/components/schemas/ByteBoundedText65536"
          },
          "timeout_ms": {
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "sql",
          "format"
        ],
        "type": "object"
      },
      "QueryResponse": {
        "additionalProperties": false,
        "properties": {
          "columns": {
            "items": {
              "$ref": "#/components/schemas/QueryColumn"
            },
            "type": "array"
          },
          "duration_ms": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "estimated_total_rows": {
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "freshness": {
            "items": {
              "$ref": "#/components/schemas/Freshness"
            },
            "type": "array"
          },
          "hints": {
            "items": {
              "$ref": "#/components/schemas/BoundedText2000"
            },
            "type": "array"
          },
          "knowledge_version": {
            "$ref": "#/components/schemas/Label"
          },
          "policy_version": {
            "$ref": "#/components/schemas/Label"
          },
          "query_id": {
            "$ref": "#/components/schemas/QueryId"
          },
          "returned_rows": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "rows": {
            "items": {
              "items": {
                "$ref": "#/components/schemas/QueryCell"
              },
              "type": "array"
            },
            "type": "array"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceWatermark"
            },
            "type": "array"
          },
          "star_expanded": {
            "items": {
              "$ref": "#/components/schemas/QualifiedTable"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "truncated": {
            "type": "boolean"
          },
          "truncation_reasons": {
            "items": {
              "$ref": "#/components/schemas/TruncationReason"
            },
            "type": "array"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/Warning"
            },
            "type": "array"
          }
        },
        "required": [
          "query_id",
          "columns",
          "rows",
          "returned_rows",
          "truncated",
          "duration_ms",
          "freshness",
          "sources",
          "warnings",
          "knowledge_version",
          "policy_version"
        ],
        "type": "object"
      },
      "Rfc3339Timestamp": {
        "format": "date-time",
        "maxLength": 35,
        "minLength": 20,
        "type": "string"
      },
      "SourceName": {
        "maxLength": 63,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]{0,62}$",
        "type": "string"
      },
      "SourceWatermark": {
        "additionalProperties": false,
        "properties": {
          "applied_pos": {
            "$ref": "#/components/schemas/Position"
          },
          "consistency": {
            "$ref": "#/components/schemas/ConsistencyMode"
          },
          "cross_table_consistent": {
            "type": "boolean"
          },
          "source": {
            "$ref": "#/components/schemas/SourceName"
          }
        },
        "required": [
          "source",
          "consistency",
          "cross_table_consistent",
          "applied_pos"
        ],
        "type": "object"
      },
      "TableName": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
        "type": "string"
      },
      "TimezoneName": {
        "maxLength": 98,
        "minLength": 3,
        "pattern": "^(?:UTC|Etc/UTC|[A-Za-z][A-Za-z0-9_+-]{0,31}(?:/[A-Za-z0-9_+-]{1,32}){1,2})$",
        "type": "string"
      },
      "TruncationReason": {
        "enum": [
          "rows",
          "bytes",
          "cell"
        ],
        "type": "string"
      },
      "Warning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/WarningCode"
          },
          "column": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TableName"
              },
              {
                "type": "null"
              }
            ]
          },
          "impact": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Label"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "$ref": "#/components/schemas/BoundedText2000"
          },
          "rows": {
            "description": "Row count from the CLI example. It is not an amount.",
            "format": "int64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "table": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/QualifiedTable"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "WarningCode": {
        "enum": [
          "RECONCILE_MISMATCH",
          "RECONCILE_STALE",
          "VALUES_REJECTED",
          "UNEXPLAINED_CODES",
          "PARTIAL_TRANSACTION",
          "CROSS_TABLE_SKEW",
          "ENTITY_CHECK_FAILED",
          "STALE_DATA"
        ],
        "type": "string"
      }
    }
  },
  "info": {
    "description": "SP00 component schemas only. This document has no operations. It is not a running server, and a schema match is not evidence of HTTP behavior.",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "Open Ontology contracts",
    "version": "api/v1"
  },
  "openapi": "3.1.0",
  "paths": {}
}
