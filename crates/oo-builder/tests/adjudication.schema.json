{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "input_sha256",
    "thresholds",
    "items",
    "graph",
    "summary_sha256"
  ],
  "properties": {
    "protocol": {
      "const": "oo.adjudication/v1"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "thresholds": {
      "type": "object",
      "required": [
        "relation_containment_strict",
        "relation_containment_with_signal",
        "code_coverage"
      ],
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "class",
          "subject",
          "decision",
          "evidence",
          "scores",
          "rule_id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "class": {
            "enum": [
              "relation",
              "sensitive",
              "metric",
              "entity_key",
              "code_table"
            ]
          },
          "subject": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision": {
            "enum": [
              "adopted",
              "rejected",
              "hidden",
              "visible",
              "certified",
              "demoted",
              "adopted",
              "rejected",
              "complete",
              "incomplete"
            ]
          },
          "evidence": {
            "type": "object"
          },
          "scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "confidence"
            ],
            "properties": {
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "class": {
                  "const": "relation"
                }
              }
            },
            "then": {
              "properties": {
                "decision": {
                  "enum": [
                    "adopted",
                    "rejected"
                  ]
                },
                "id": {
                  "pattern": "^relation/"
                },
                "rule_id": {
                  "pattern": "^relation\\."
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "sensitive"
                }
              }
            },
            "then": {
              "properties": {
                "decision": {
                  "enum": [
                    "hidden",
                    "visible"
                  ]
                },
                "id": {
                  "pattern": "^sensitive/"
                },
                "rule_id": {
                  "pattern": "^sensitive\\."
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "metric"
                }
              }
            },
            "then": {
              "properties": {
                "decision": {
                  "enum": [
                    "certified",
                    "demoted"
                  ]
                },
                "id": {
                  "pattern": "^metric/"
                },
                "rule_id": {
                  "pattern": "^metric\\."
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "entity_key"
                }
              }
            },
            "then": {
              "properties": {
                "decision": {
                  "enum": [
                    "adopted",
                    "rejected"
                  ]
                },
                "id": {
                  "pattern": "^entity_key/"
                },
                "rule_id": {
                  "pattern": "^entity_key\\."
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "class": {
                  "const": "code_table"
                }
              }
            },
            "then": {
              "properties": {
                "decision": {
                  "enum": [
                    "complete",
                    "incomplete"
                  ]
                },
                "id": {
                  "pattern": "^code_table/"
                },
                "rule_id": {
                  "pattern": "^code_table\\."
                }
              }
            }
          }
        ]
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "edges"
      ],
      "properties": {
        "dictionary_bindings_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "table",
              "key",
              "display",
              "rows"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "table": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "display": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "from",
              "to",
              "cardinality",
              "adopted"
            ],
            "properties": {
              "relation": {
                "type": "string",
                "minLength": 1
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "cardinality": {
                "enum": [
                  "one_to_one",
                  "one_to_many",
                  "many_to_one",
                  "many_to_many"
                ]
              },
              "adopted": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "summary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "budget",
        "checked",
        "remaining",
        "unchecked"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "budget": {
          "type": "integer",
          "minimum": 0
        },
        "checked": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        },
        "unchecked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "from",
              "to",
              "from_columns",
              "to_columns"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^relation/"
              },
              "kind": {
                "enum": [
                  "declared_fk",
                  "inferred_id",
                  "snapshot_name_mapping"
                ]
              },
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "from_columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "to_columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "remaining": {
                "const": 0
              },
              "unchecked": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "remaining": {
                "minimum": 1
              },
              "unchecked": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
