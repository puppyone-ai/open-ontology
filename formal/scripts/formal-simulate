#!/usr/bin/env bash
# CI job `formal-simulate` (80 section 6): quint run random simulation, fixed seed.
# FORMAL_SAMPLES (default 10000 traces per model), FORMAL_SEED (default 0x464d).
source "$(dirname "$0")/_env.sh"
samples="${FORMAL_SAMPLES:-10000}"
seed="${FORMAL_SEED:-0x464d}"
n=0
while IFS=$'\t' read -r file main inv steps vsteps wit; do
  echo "simulate ${file#"$FORMAL_ROOT"/} main=$main inv=$inv samples=$samples steps=$steps seed=$seed"
  quint run "$file" --main="$main" --invariant="$inv" --max-samples="$samples" \
    --max-steps="$steps" --seed="$seed" | tail -n 6
  if [ -n "$wit" ]; then
    # shellcheck disable=SC2086
    quint run "$file" --main="$main" --max-samples="$samples" --max-steps="$steps" \
      --seed="$seed" --witnesses $wit | grep 'witnessed'
  fi
  n=$((n + 1))
done < <(formal_models)
echo "formal-simulate: $n model(s) ok"
