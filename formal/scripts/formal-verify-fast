#!/usr/bin/env bash
# CI job `formal-verify-fast` (80 section 6): Apalache bounded check at the FAST bound
# (`verify-steps` in each model header; every (model, invariant) pair fits a 15 minute job).
# `formal-verify-deep` runs this same loop at the nightly bound (`deep-steps`).
# Usage: formal-verify-fast [model-file-substring] [invariant]
# CI runs one (model, invariant) pair per matrix job. For parallel runs on one machine set
# FORMAL_APALACHE_PORT to a free port per process (see formal_verify_one in _env.sh).
# Prints one line per pair: result, wall seconds.
source "$(dirname "$0")/_env.sh"
only="${1:-}"
only_inv="${2:-}"
bound="${FORMAL_BOUND:-fast}"
n=0
while IFS=$'\t' read -r file main inv steps vsteps wit vinv dsteps dinv; do
  case "$file" in *"$only"*) ;; *) continue ;; esac
  k="$vsteps"; [ "$bound" = deep ] && k="$dsteps"
  list="$vinv"; [ "$bound" = deep ] && list="$vinv $dinv"
  for i in $list; do
    if [ -n "$only_inv" ] && [ "$i" != "$only_inv" ]; then continue; fi
    echo "verify[$bound] ${file#"$FORMAL_ROOT"/} main=$main invariant=$i max-steps=$k"
    t0=$(date +%s)
    formal_verify_one "$file" "$main" "$i" "$k"
    echo "  wall $(( $(date +%s) - t0 )) s"
  done
  n=$((n + 1))
done < <(formal_models)
echo "formal-verify-$bound: $n model(s) ok"
