#!/usr/bin/env bash
# CI job `formal-verify-fast` (80 section 6): Apalache bounded check at default bounds.
# Usage: formal-verify-fast [model-file-substring]
source "$(dirname "$0")/_env.sh"
only="${1:-}"
n=0
while IFS=$'\t' read -r file main inv steps vsteps wit; do
  case "$file" in *"$only"*) ;; *) continue ;; esac
  echo "verify ${file#"$FORMAL_ROOT"/} main=$main invariant=$inv max-steps=$vsteps"
  quint verify "$file" --main="$main" --invariant="$inv" --max-steps="$vsteps" | tail -n 6
  n=$((n + 1))
done < <(formal_models)
echo "formal-verify-fast: $n model(s) ok"
