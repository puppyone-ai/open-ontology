{
  "name": "@reduxxx888/ontology-cli",
  "version": "0.2.0",
  "description": "Standalone Open Ontology CLI with a verified packaged native executable.",
  "type": "module",
  "license": "Apache-2.0",
  "ooPlatforms": ["darwin-arm64", "darwin-x64", "linux-arm64", "linux-x64"],
  "bin": {
    "oo": "bin/oo.mjs",
    "ontology": "bin/oo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin/oo.mjs",
    "bin/auth.mjs",
    "native/manifest.json",
    "native/*/oo",
    "native/*/oo.exe",
    "native/*/oo-lite-image",
    "native/*/oo-mysql-doctor",
    "native/*/oo-mysql-doctor.exe",
    "native/*/mcp-gateway",
    "native/*/mcp-gateway.exe",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt",
    "dependencies.json",
    "SKILL.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
