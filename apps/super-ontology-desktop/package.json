{
  "name": "@open-ontology/super-ontology-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Super Ontology: the desktop app for Open Ontology",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main/index.mjs",
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "dev:bridge": "node scripts/dev-bridge.mjs",
    "build": "node scripts/build-renderer.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:visual": "playwright test --config config/playwright.visual.config.ts",
    "test:t1": "node tests/e2e/run-t1.mjs",
    "test:t2": "node tests/e2e/t2/run-packaged.mjs",
    "types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config eslint.config.mjs src scripts electron tests *.ts",
    "gen:contract": "node scripts/gen-contract.mjs",
    "gen:contract:check": "node scripts/gen-contract.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "gen:icon": "node scripts/gen-icon.mjs",
    "gen:notice": "node scripts/gen-notice.mjs",
    "gen:notice:check": "node scripts/gen-notice.mjs --check",
    "prepare:oo": "node scripts/prepare-oo-bundle.mjs",
    "shots": "node scripts/electron-shots.mjs",
    "dist:mac": "pnpm run gen:icon && pnpm run gen:notice && pnpm run build && pnpm run prepare:oo && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml --mac dmg --arm64 --publish never"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-force": "3.0.10",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "electron": "44.11.1",
    "electron-builder": "26.18.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "intl-messageformat": "11.2.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@open-ontology/design-system": "workspace:*",
    "d3-force": "3.0.1",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  }
}
