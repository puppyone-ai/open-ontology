+fn people() -> JsonlProfile {
+    profile(
+        "people",
+        vec![
+            column("name", JsonlType::Utf8, true),
+            column("ok", JsonlType::Bool, false),
+            column("n", JsonlType::Int64, false),
+        ],
+    )
+}
