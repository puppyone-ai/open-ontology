2026-10-03 17:48:38.071 UTC app=psql user=postgres db=oo_a137 LOG:  statement: SELECT 'column_only|' || CURRENT_USER::text || '|' ||
	  has_table_privilege(CURRENT_USER, c.oid, 'SELECT') || '|' ||
	  has_column_privilege(CURRENT_USER, a.attrelid, a.attnum, 'SELECT') || '|' ||
	  EXISTS (SELECT 1 FROM pg_catalog.aclexplode(COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))) AS x WHERE x.privilege_type = 'SELECT' AND (x.grantee = 0 OR pg_catalog.pg_has_role(CURRENT_USER, x.grantee, 'USAGE'))) || '|' ||
	  EXISTS (SELECT 1 FROM pg_catalog.aclexplode(a.attacl) AS x WHERE x.privilege_type = 'SELECT' AND (x.grantee = 0 OR pg_catalog.pg_has_role(CURRENT_USER, x.grantee, 'USAGE'))) || '|' ||
	  (CASE WHEN a.attnum IS NULL THEN NULL ELSE (
	    EXISTS (SELECT 1 FROM pg_catalog.pg_roles r WHERE r.rolname = CURRENT_USER AND r.rolsuper)
	    OR pg_catalog.pg_has_role(CURRENT_USER, 'pg_read_all_data', 'USAGE')
	    OR EXISTS (SELECT 1 FROM pg_catalog.aclexplode(COALESCE(c.relacl, pg_catalog.acldefault('r', c.relowner))) AS x WHERE x.privilege_type = 'SELECT' AND (x.grantee = 0 OR pg_catalog.pg_has_role(CURRENT_USER, x.grantee, 'USAGE')))
	    OR EXISTS (SELECT 1 FROM pg_catalog.aclexplode(a.attacl) AS x WHERE x.privilege_type = 'SELECT' AND (x.grantee = 0 OR pg_catalog.pg_has_role(CURRENT_USER, x.grantee, 'USAGE')))
	  ) END)::text
	FROM pg_class c
	JOIN pg_namespace n ON n.oid = c.relnamespace
