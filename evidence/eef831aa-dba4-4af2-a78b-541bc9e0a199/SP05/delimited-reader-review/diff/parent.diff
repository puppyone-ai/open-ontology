+struct OneByte<R> {
+    inner: R,
+}
+
+impl<R: Read> Read for OneByte<R> {
+    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+        if buf.is_empty() {
+            return Ok(0);
+        }
+        let mut one = [0u8; 1];
+        let read = self.inner.read(&mut one)?;
+        if read == 1 {
+            buf[0] = one[0];
+        }
+        Ok(read)
+    }
+}
