+}
+
+/// The pull has no further record. This is not [`DelimitedComplete`].
+/// There is no boolean EOF admission on this value.
+#[derive(Clone, Debug, PartialEq, Eq)]
+#[non_exhaustive]
+pub struct DelimitedExhausted {
