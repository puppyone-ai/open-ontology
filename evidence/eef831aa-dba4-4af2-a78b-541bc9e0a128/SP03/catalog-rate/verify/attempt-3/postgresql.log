2026-10-03 11:53:01.873 UTC app=oo-pg-source user=oo_snap_reader db=snapdb LOG:  execute sqlx_s_7: SELECT w.ord::int8, w.schema_name, w.table_name, n.oid::int8, c.oid::int8, c.relkind::text, c.relowner::int8, pg_catalog.pg_get_userbyid(c.relowner)::text, c.relrowsecurity, c.relforcerowsecurity, c.relreplident::text, pg_catalog.obj_description(c.oid, 'pg_class'), pg_catalog.has_schema_privilege(CURRENT_USER, n.oid, 'USAGE'), pg_catalog.has_schema_privilege(CURRENT_USER, n.oid, 'CREATE'), pg_catalog.has_table_privilege(CURRENT_USER, c.oid, 'SELECT'), pg_catalog.has_table_privilege(CURRENT_USER, c.oid, 'INSERT'), pg_catalog.has_table_privilege(CURRENT_USER, c.oid, 'UPDATE'), pg_catalog.has_table_privilege(CURRENT_USER, c.oid, 'DELETE'), pg_catalog.has_table_privilege(CURRENT_USER, c.oid, 'TRUNCATE') FROM unnest($1::text[], $2::text[]) WITH ORDINALITY AS w(schema_name, table_name, ord) LEFT JOIN pg_catalog.pg_namespace n ON n.nspname = w.schema_name LEFT JOIN pg_catalog.pg_class c ON c.relnamespace = n.oid AND c.relname = w.table_name AND c.relkind IN ('r', 'p') ORDER BY w.ord LIMIT $3::int8
