+
+fn parts_are_contiguous(parts: &BTreeMap<u32, u64>) -> bool {
+    if parts.is_empty() {
+        return false;
+    }
+    let mut expected = 1u32;
+    for number in parts.keys() {
+        if *number != expected {
+            return false;
+        }
+        expected = match expected.checked_add(1) {
+            Some(next) => next,
+            None => return false,
+        };
+    }
+    true
+}
