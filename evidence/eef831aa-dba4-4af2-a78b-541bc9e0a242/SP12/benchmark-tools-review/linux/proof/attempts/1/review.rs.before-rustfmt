fn stream(header_line: &str, rows: &[&str], status: &str, truncated: bool, count: u64, end_audit: bool) -> String {
    let mut out = String::from(header_line);
    out.push('\n');
    for row in rows {
        out.push_str(row);
        out.push('\n');
    }
    out.push_str(&summary_line(status, truncated, count, end_audit));
    out.push('\n');
    out
}

