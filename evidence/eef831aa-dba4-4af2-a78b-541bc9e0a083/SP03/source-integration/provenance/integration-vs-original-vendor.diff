@@ -22,6 +22,22 @@
 // <https://doc.rust-lang.org/unstable-book/language-features/doc-cfg.html>
 #![cfg_attr(docsrs, feature(doc_cfg))]
 
+// Open Ontology integration guard. Compiled for every feature set. Public
+// roots and native TLS fail the build, including an additive union with
+// `_tls-rustls-ring-no-roots`.
+#[cfg(any(
+    feature = "webpki-roots",
+    feature = "rustls-native-certs",
+    feature = "native-tls",
+    feature = "_tls-rustls-ring-webpki",
+    feature = "_tls-rustls-ring-native-roots",
+    feature = "_tls-rustls-aws-lc-rs",
+    feature = "_tls-native-tls",
+))]
+compile_error!(
+    "Open Ontology patched sqlx-core rejects SQLx public-root and native-TLS features (webpki-roots, rustls-native-certs, native-tls, _tls-rustls-ring-webpki, _tls-rustls-ring-native-roots, _tls-rustls-aws-lc-rs, _tls-native-tls), including additive combinations with _tls-rustls-ring-no-roots. The only admitted TLS feature is _tls-rustls-ring-no-roots."
+);
+
 #[macro_use]
 pub mod ext;
 
