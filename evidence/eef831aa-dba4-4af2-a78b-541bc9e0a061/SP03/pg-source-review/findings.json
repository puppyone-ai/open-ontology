  "findings": [
    {
      "id": "PG-ADMIT-UNSELECTED",
      "severity": "high",
      "decision_effect": "request_changes",
      "summary": "registration_allowed is true for logins that can write or create outside the selected tables.",
      "evidence": [
        "oo_src_side INSERT on app.side_write, registration_allowed true, write read_only",
        "oo_src_hiddenfn EXECUTE hidden.boom SECURITY DEFINER, registration_allowed true, definer list empty",
        "oo_src_schemacreate CREATE on schema side, registration_allowed true",
        "oo_src_dbcreate CREATE on database source_lab, registration_allowed true"
      ],
      "spec": ["docs/03 I-SRC-3", "docs/03 §5.2 PostgreSQL write row", "REQ-SRC-02"],
      "repro": "Grant INSERT on a table that is not in TableSelection, or EXECUTE on a SECURITY DEFINER function outside public and the selected schemas, then call inspect_access. registration_allowed is true."
    },
    {
      "id": "PG-OPTIONS-ROLE",
      "severity": "high",
      "decision_effect": "request_changes",
      "summary": "PGOPTIONS -c role= switches current_user before inspection and a write-capable login is reported read-only.",
      "evidence": {
        "without_pgoptions": "oo_src_dual registration_allowed false, block write_capable",
        "with_pgoptions": "current_user oo_src_reader, session_user oo_src_dual, registration_allowed true, write read_only, findings 0",
        "server_version_override": {"kind": "Protocol", "sqlstate": "55P02"}
      },
      "repro": "PGOPTIONS='-c role=oo_src_reader' connect as oo_src_dual and call inspect_access."
    },
    {
      "id": "PG-TLS-WEBPKI",
      "severity": "high",
      "decision_effect": "request_changes",
      "summary": "The caller CA is added to the Mozilla webpki roots. A private-CA-only trust store is not available.",
      "evidence": [
        "sqlx-core 0.9.0 tls_rustls.rs import_root_certs uses webpki_roots::TLS_SERVER_ROOTS, then the handshake adds the caller PEM",
        "TlsReport.trust is configured-ca-plus-webpki-roots",
        "cargo tree shows webpki-roots 1.0.9",
        "wrong CA and wrong host return Tls/tls_handshake",
        "PGSSLMODE=disable still produced TLSv1.3"
      ],
      "repro": "Read the locked handshake and the feature tree. Wrong-CA and wrong-host checks do not remove the Mozilla roots."
    }
  ],
