CREATE OR REPLACE FUNCTION _oo.segment_contract_ready(p_checksum text)
 RETURNS boolean
 LANGUAGE sql
 STABLE
 SET search_path TO 'pg_catalog', '_oo'
AS $function$
  SELECT EXISTS (
    SELECT 1
    FROM _oo.schema_migrations AS recorded
    WHERE recorded.version = 'target-fence-receipts/2'
      AND recorded.phase = 'expand'
      AND recorded.checksum = p_checksum
      AND p_checksum ~ '^[0-9a-f]{64}$'
  );
$function$

