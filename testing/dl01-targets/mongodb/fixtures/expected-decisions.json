{
  "n": 100,
  "presence_rule": "present * 10 >= n * 9",
  "consistency_rule": "dominant_count * 100 >= present * 99",
  "tie_break": "highest count, then bson type name ascending",
  "null_counts_as_present": true,
  "missing_is_absent_key": true,
  "array_child_table": false,
  "unclassified_default_visible": false,
  "consistency_grade": "B",
