    "small_units": {"bucket": "stable", "dominant": "int64", "present": 100, "dominant_count": 100, "pg_type": "bigint", "nullable": false},
    "price": {"bucket": "stable", "dominant": "decimal128", "present": 100, "dominant_count": 100, "pg_type": "numeric", "nullable": false, "value_reject": ["NaN", "Infinity", "-Infinity"]},
    "warehouse": {"bucket": "stable", "dominant": "string", "present": 100, "dominant_count": 100, "pg_type": "text", "nullable": false},
    "flag": {"bucket": "stable", "dominant": "int32", "present": 100, "dominant_count": 100, "pg_type": "int4", "nullable": false},
    "created": {"bucket": "stable", "dominant": "date", "present": 100, "dominant_count": 100, "pg_type": "timestamptz", "nullable": false},
    "uid": {"bucket": "stable", "dominant": "binary:04", "present": 100, "dominant_count": 100, "pg_type": "uuid", "nullable": false},
    "blob": {"bucket": "stable", "dominant": "binary:00", "present": 100, "dominant_count": 100, "pg_type": "bytea", "nullable": false},
    "weight": {"bucket": "stable", "dominant": "double", "present": 100, "dominant_count": 100, "pg_type": "float8", "nullable": false, "caveat": "binary64"},
    "note_null_boundary": {"bucket": "stable", "dominant": "string", "present": 100, "dominant_count": 99, "pg_type": "text", "nullable": true},
    "tags": {"bucket": "retained_in_doc", "dominant": "array", "present": 100, "dominant_count": 100, "reason": "array stays jsonb; no child table"},
    "nested_arr": {"bucket": "retained_in_doc", "dominant": "array", "present": 100, "dominant_count": 100, "reason": "array of objects stays jsonb"},
    "payload": {"bucket": "retained_in_doc", "dominant": "object", "present": 100, "dominant_count": 100, "reason": "subdocument is not a scalar"},
    "explicit_null": {"bucket": "retained_in_doc", "dominant": "null", "present": 100, "dominant_count": 100, "reason": "explicit null is present and is not a scalar column type"},
    "note_drift": {"bucket": "type_drift", "dominant": "string", "present": 100, "dominant_count": 98, "reason": "two explicit nulls drop consistency below 99/100"},
    "mixed": {"bucket": "type_drift", "dominant": "int64", "present": 100, "dominant_count": 50, "reason": "tie string/int64 broken by type name; consistency 50/100"},
    "count_drift": {"bucket": "type_drift", "dominant": "int64", "present": 100, "dominant_count": 97, "reason": "three int32 values"},
    "rare_code": {"bucket": "unclassified", "dominant": "string", "present": 89, "dominant_count": 89, "default_visible": false},
    "new_attr": {"bucket": "unclassified", "dominant": "string", "present": 5, "dominant_count": 5, "default_visible": false}
  },
