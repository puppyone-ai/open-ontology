  },
  "must_fail": ["negative_varbinary", "negative_partition", "negative_streams", "negative_reader_insert", "negative_reader_update", "negative_reader_delete", "negative_reader_create", "negative_reader_drop", "negative_reader_alter", "negative_reader_truncate", "negative_missing_partition"],
